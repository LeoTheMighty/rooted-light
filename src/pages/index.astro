---
// Home (FR-2 shape), themed by rlw105: hero carries Kylie's name (rlw111
// locked decision "Kylie on front page") and a favorite-quote band in the
// picked mockup's treatment. Placeholder quote is the round-4 mockup's —
// Kylie swaps in her own favorite later.
import Page from "../layouts/Page.astro";
import site from "../content/site.json";
import { withBase } from "../lib/paths";
---

<Page title={site.name} bareTitle>
  <section class="card hero">
    <!-- TODO(kylie): hero photo/imagery -->
    <h1>{site.name}</h1>
    <p class="owner-line">{site.owner_line}</p>
    <p>{site.intention}</p>
  </section>
  <section class="quote-band">
    <!-- TODO(kylie): swap in your favorite quote + attribution -->
    <figure>
      <blockquote>
        <p>The wound is the place where the Light enters you.</p>
      </blockquote>
      <figcaption>— Rumi</figcaption>
    </figure>
  </section>
  <section>
    <h2>Begin where you are</h2>
    <ul>
      <li><a href={withBase("/about-me/")}>About Me</a> — who I am and how I work</li>
      <li><a href={withBase("/about-you/")}>About You</a> — who this practice serves</li>
      <li><a href={withBase("/modalities/")}>Modalities</a> — the ways of working, in plain language</li>
      <li><a href={withBase("/offerings/")}>Offerings</a> — reiki sessions, training, and therapy</li>
      <li><a href={withBase("/resources/")}>Resources</a> — plain-language explainers</li>
    </ul>
  </section>
</Page>
