---
// Home stub (FR-2 shape): hero area placeholder, name + intention line,
// clear paths into About, Offerings, Resources. The final home is themed
// in the theme-promotion phase; mockup variants land in /mockups/.
import Page from "../layouts/Page.astro";
import site from "../content/site.json";
---

<Page title={site.name} bareTitle>
  <section class="card">
    <!-- TODO(kylie): hero photo/imagery -->
    <h1>{site.name}</h1>
    <p>{site.intention}</p>
  </section>
  <section>
    <h2>Begin where you are</h2>
    <ul>
      <li><a href="/about-me/">About Me</a> — who I am and how I work</li>
      <li><a href="/about-you/">About You</a> — who this practice serves</li>
      <li><a href="/offerings/">Offerings</a> — reiki sessions, training, and therapy</li>
      <li><a href="/resources/">Resources</a> — plain-language explainers</li>
    </ul>
  </section>
</Page>
