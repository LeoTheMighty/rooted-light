---
// Therapy page (T3.5): inquiry-only — no booking affordances, ever
// (E-3 contract). Short modality summaries link into the top-level
// /modalities/ catalog (IA revised 2026-07-25); the inquiry form posts
// to the contact.form_action seam; small Psychology Today link; crisis
// note stays.
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import site from "../../content/site.json";

const modalities = (await getCollection("modalities")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Page
  title="Therapy"
  description="Therapy with Kylie Fustini begins with a conversation, not a checkout."
>
  <p>
    Therapy with Kylie begins with a conversation, not a checkout.
    Scheduling, paperwork, and intake all happen after we connect.
    <!-- TODO(kylie): voice pass -->
  </p>
  <section>
    <h2>How I work</h2>
    <p>
      Sessions draw on a few ways of working, met where you are. Each is
      described in plain language in the
      <a href="/modalities/">modality catalog</a>.
    </p>
    {
      modalities.map((m) => (
        <article class="card">
          <h3>{m.data.title}</h3>
          <p>{m.data.summary}</p>
          <p>
            <a href={`/modalities/#${m.id}`}>More about {m.data.title} →</a>
          </p>
        </article>
      ))
    }
  </section>
  <section>
    <h2>Reach out</h2>
    <p>
      Share as much or as little as feels right — this is an inquiry, not an
      intake.
    </p>
    <InquiryForm />
    <p class="small-note">
      Kylie will also be listed on
      <!-- TODO(kylie): swap the directory link for her profile URL -->
      <a href={site.contact.psychology_today_url}>Psychology Today</a>
      (profile link coming soon).
    </p>
  </section>
  <section>
    <h2>If you need help right now</h2>
    <p>
      This practice is not an emergency service. If you are in crisis, call
      or text <strong>988</strong> (Suicide &amp; Crisis Lifeline, US) or go
      to your nearest emergency room.
    </p>
  </section>
</Page>
