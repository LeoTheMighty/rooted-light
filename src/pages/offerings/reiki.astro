---
// Reiki page (T3.3): what it is / what a session is like / training,
// with the BookingCTA component carrying the [data-cta="booking"]
// contract. Hrefs stay on the site.json booking seams (placeholder
// until rlw106 wires the chosen provider).
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import BookingCTA from "../../components/BookingCTA.astro";
import site from "../../content/site.json";
import { withBase } from "../../lib/paths";

const offerings = (await getCollection("offerings")).sort(
  (a, b) => a.data.order - b.data.order,
);
const sessions = offerings.filter((o) => o.data.kind === "session");
const trainings = offerings.filter((o) => o.data.kind === "training");
---

<Page
  title="Reiki"
  description="Reiki sessions and training with Kylie Fustini — grounding, gentle, unhurried."
>
  <section>
    <h2>What reiki is</h2>
    <p>
      Placeholder: a grounded description of reiki energy work — gentle,
      non-invasive, unhurried. <!-- TODO(kylie) -->
    </p>
    <p>
      New to reiki? Start with
      <a href={withBase("/resources/what-is-reiki/")}>the plain-language explainer</a>.
    </p>
  </section>
  <section>
    <h2>What a session is like</h2>
    <p>
      Placeholder: how a session unfolds — arriving, settling in, the
      hands-on (or hands-off) work itself, and the quiet close. How long it
      runs, what to wear, what to bring. <!-- TODO(kylie) -->
    </p>
    {
      sessions.map((o) => (
        <article class="card">
          <h3>{o.data.title}</h3>
          <p>{o.data.summary}</p>
        </article>
      ))
    }
    <p>
      <BookingCTA href={site.booking.url} label="Book a reiki session" />
      <span class="small-note">(online booking opens soon)</span>
    </p>
  </section>
  <section>
    <h2>Training</h2>
    <p>
      Placeholder: learning reiki yourself — levels, lineage, and what each
      training covers. <!-- TODO(kylie) -->
    </p>
    {
      trainings.map((o) => (
        <article class="card">
          <h3>{o.data.title}</h3>
          <p>{o.data.summary}</p>
        </article>
      ))
    }
    <p>
      <BookingCTA
        href={site.booking.training_url}
        label="Sign up for reiki training"
      />
      <span class="small-note">(sign-up opens soon)</span>
    </p>
  </section>
</Page>
