---
// Top-level Modalities catalog (FR-13, IA revised 2026-07-25): the
// four-field accordion with stable id anchors that About You and the
// Therapy page deep-link into. Zero client JS — <details> is native.
import { getCollection } from "astro:content";
import Page from "../layouts/Page.astro";
import ModalityAccordion from "../components/ModalityAccordion.astro";

const modalities = (await getCollection("modalities")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Page
  title="Modalities"
  description="The ways of working in this practice — what each is, who benefits, and the training behind it."
>
  <p>
    The ways of working you'll meet in this practice — each in plain
    language: what it is, who tends to benefit, where to read more, and the
    training behind it. <!-- TODO(kylie): intro voice pass -->
  </p>
  {modalities.map((m) => <ModalityAccordion modality={m} />)}
  <p>
    Curious how these fit together in a session? Start with
    <a href="/offerings/therapy/">therapy</a> or browse the
    <a href="/resources/">resources</a>.
  </p>
</Page>
