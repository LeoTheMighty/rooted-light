---
// One explainer page per resources-collection entry (T3.2). The body
// markdown is the explainer; frontmatter links render as references.
import { getCollection, render } from "astro:content";
import Page from "../../layouts/Page.astro";

export async function getStaticPaths() {
  const resources = await getCollection("resources");
  return resources.map((r) => ({
    params: { slug: r.id },
    props: { resource: r },
  }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
---

<Page title={resource.data.title} description={resource.data.summary}>
  <Content />
  {
    resource.data.links.length > 0 && (
      <section>
        <h2>References</h2>
        <ul>
          {resource.data.links.map((l) => (
            <li>
              <a href={l.url}>{l.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <p><a href="/resources/">← All resources</a></p>
</Page>
