---
// Review index for Kylie: one card per style direction with real color
// swatches parsed from the pack CSS at build time (no drift), a
// one-liner, and a link. Self-contained (inline CSS, explicit
// index.html links) so it works from a zip over file:// on a phone.
import site from "../../content/site.json";
import { directions } from "./_directions";

const packSources = import.meta.glob("../../styles/tokens/pack-*.css", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

// Comments are stripped before parsing so a commented-out declaration
// can never drive a swatch; a missing token fails the build loudly
// instead of rendering `background:undefined`.
const token = (css: string, pack: string, name: string) => {
  const stripped = css.replace(/\/\*[\s\S]*?\*\//g, "");
  const v = (stripped.match(new RegExp(`${name}\\s*:\\s*([^;]+);`)) ||
    [])[1]?.trim();
  if (!v) throw new Error(`${pack}: token ${name} missing or unparseable`);
  return v;
};

// Numbering is CONTINUOUS across rounds (1–5 refinements, 6–12
// originals) so a "number N" reply means the same mockup here and in
// the single-file share artifact, which numbers in the same order.
const cards = directions.map((d, idx) => {
  const entry = Object.entries(packSources).find(([path]) =>
    path.endsWith(`/${d.pack}.css`),
  );
  if (!entry) throw new Error(`no token pack found for ${d.pack}`);
  const css = entry[1];
  const fontRaw = token(css, d.pack, "--font-heading");
  return {
    ...d,
    num: idx + 1,
    bg: token(css, d.pack, "--color-bg"),
    surface: token(css, d.pack, "--color-surface"),
    accent: token(css, d.pack, "--color-accent"),
    heading: token(css, d.pack, "--color-text-heading"),
    font: fontRaw,
    fontName: fontRaw.split(",")[0]?.replace(/"/g, "").trim(),
  };
});

const rounds = [
  {
    key: 4,
    title: "Round 4 — tan & lilac, the decision round (start here)",
    note: "No. 13's layout with tan and lilac, inspired by the site you shared. Each one is a full mockup (tap through its pages) AND a concrete proposal: two lead with tan, two lead with lilac, two keep a neutral base where both share. Kylie's name is on every front page, and each has a favorite-quote space. The decision sheet at the bottom of every page lists its exact shades and fonts — reply with a number, and feel free to mix (\"19's colors with 17's fonts\").",
    cards: cards.filter((c) => c.round === 4),
  },
  {
    key: 3,
    title: "Round 3 — grounded mist, multi-page (for reference)",
    note: "Lavender mist's type and palette, no gradient, real pages. These varied the navigation — no. 13's classic bar won and is the skeleton round 4 builds on.",
    cards: cards.filter((c) => c.round === 3),
  },
  {
    key: 2,
    title: "Round 2 — lavender refinements (for reference)",
    note: "Five takes on the dusk feel — same simple structure and lavender gradient, different temperature and type. Lavender mist (no. 1) was the closest.",
    cards: cards.filter((c) => c.round === 2),
  },
  {
    key: 1,
    title: "Round 1 — the original directions (for reference)",
    note: "The first exploration, kept for comparison. Soft lavender dusk (no. 8) was the winner.",
    cards: cards.filter((c) => c.round === 1),
  },
];

for (const r of rounds) {
  if (!r.cards.length)
    throw new Error(`review index round ${r.key} has zero cards — registry filter broke`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Style directions · {site.name}</title>
    <meta
      name="description"
      content={`Review index: ${cards.length} home-page style directions for ${site.name}.`}
    />
    <style is:inline>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      * {
        margin: 0;
      }
      body {
        background: #faf8f4;
        color: #3d3a33;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
        padding: 1.5rem 1.25rem 4rem;
      }
      .intro {
        max-width: 38rem;
        margin: 0 auto 2rem;
        text-align: center;
      }
      .intro h1 {
        font-family: Georgia, serif;
        color: #4a5544;
        font-size: 1.7rem;
      }
      .intro p {
        margin-top: 0.7rem;
      }
      .intro .how {
        margin-top: 1rem;
        background: #f1ede4;
        border-radius: 8px;
        padding: 0.8rem 1rem;
        font-size: 0.92rem;
      }
      .round {
        max-width: 60rem;
        margin: 0 auto 2.6rem;
      }
      .round-title {
        font-family: Georgia, serif;
        color: #4a5544;
        font-size: 1.25rem;
        text-align: center;
      }
      .round-note {
        text-align: center;
        max-width: 40rem;
        margin: 0.5rem auto 1.2rem;
        font-size: 0.92rem;
      }
      .grid {
        display: grid;
        gap: 1.1rem;
      }
      @media (min-width: 640px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (min-width: 960px) {
        .grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .card {
        display: block;
        text-decoration: none;
        color: inherit;
        border: 1px solid #ddd8ca;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
      }
      .swatch {
        display: flex;
        height: 64px;
      }
      .swatch span {
        flex: 1;
      }
      .card .body {
        padding: 0.9rem 1rem 1.1rem;
      }
      .card h3 {
        font-size: 1.05rem;
        color: #4a5544;
      }
      .card .font {
        font-size: 0.78rem;
        opacity: 0.7;
        margin-top: 0.15rem;
      }
      .card p.blurb {
        font-size: 0.9rem;
        margin-top: 0.5rem;
      }
      .card p.makeup {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #5a6b4e;
        margin-top: 0.3rem;
      }
      .card .open {
        display: inline-block;
        margin-top: 0.7rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #5a6b4e;
      }
      .foot {
        text-align: center;
        margin-top: 2.5rem;
        font-size: 0.85rem;
        opacity: 0.8;
      }
    </style>
  </head>
  <body>
    <header class="intro">
      <h1>{site.name} — tan &amp; lilac</h1>
      <p>
        Round 4, the decision round: no. 13's layout dressed in tans and
        lilacs, inspired by the site you shared. The six up top each
        answer three questions — which fonts, which exact shades, and
        whether tan or lilac leads. Pick favorites for each (they don't
        have to come from the same mockup). Earlier rounds follow for
        reference.
      </p>
      <p class="how">
        A note on type: the fonts are your device’s own, so they render
        truest on an iPhone or iPad — on other devices some directions
        will share a similar typeface.
      </p>
    </header>

    <main>
      {
        rounds.map((r) => (
          <section class="round">
            <h2 class="round-title">{r.title}</h2>
            <p class="round-note">{r.note}</p>
            <div class="grid">
              {r.cards.map((c) => (
                <a class="card" href={`./${c.slug}/index.html`}>
                  <span class="swatch" aria-hidden="true">
                    <span style={`background:${c.bg}`} />
                    <span style={`background:${c.surface}`} />
                    <span style={`background:${c.accent}`} />
                    <span style={`background:${c.heading}`} />
                  </span>
                  <div class="body">
                    <h3>
                      {c.num}. {c.title}
                    </h3>
                    <p class="font" style={`font-family:${c.font}`}>
                      {c.fontName}
                    </p>
                    {c.makeup && <p class="makeup">{c.makeup}</p>}
                    <p class="blurb">{c.blurb}</p>
                    <span class="open">Open this direction →</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </main>

    <footer class="foot">
      <p>{site.legal_name} · mockup review package · {cards.length} directions</p>
    </footer>
  </body>
</html>
