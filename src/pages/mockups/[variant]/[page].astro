---
// Rounds 3–4 subpages: Offerings / Modalities / About per grounded
// variant (dist/mockups/<slug>/<page>/index.html). The route list IS
// the `pages` content object — a new page added there ships everywhere
// at once. E-7 only scans direct children of dist/mockups/, but these
// carry the same nav. (getStaticPaths is hoisted by Astro, so it can
// only use imports — not frontmatter locals.)
import GroundedPage from "../../../layouts/home/grounded/GroundedPage.astro";
import { pages } from "../../../layouts/home/_content";
import { directions, direction } from "../_directions";

export function getStaticPaths() {
  return directions
    .filter((d) => d.round >= 3)
    .flatMap((d) =>
      Object.keys(pages).map((page) => ({
        params: { variant: d.slug, page },
      })),
    );
}

const d = direction(Astro.params.variant as string);
const page = Astro.params.page as keyof typeof pages;
---

<GroundedPage variant={d} page={page} />
