---
// Lavender ink: literary and composed — left-aligned serif hero, thin
// ink rules, one roomy column, everything typographic.
import MockupShell from "./MockupShell.astro";
import layoutCss from "./HomeLavInk.css?raw";
import { home, nav } from "./_content";

interface Props {
  packCss: string;
  title: string;
  blurb?: string;
}
const { packCss, title, blurb } = Astro.props;

const sections = [
  { id: "offerings", title: "Offerings", items: home.offerings },
  { id: "modalities", title: "Modalities", items: home.modalities },
  { id: "about", title: "About", items: home.about },
];
---

<MockupShell packCss={packCss} layoutCss={layoutCss} title={title} blurb={blurb}>
  <header class="head">
    <span class="brand">{home.name}</span>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.anchor}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero" id="welcome">
      <h1>{home.tagline}</h1>
      <p class="intention">{home.intention}</p>
      <p class="cta-line"><a href={home.bookingUrl}>Book a session →</a></p>
    </section>

    {
      sections.map((s) => (
        <section class="chapter" id={s.id}>
          <h2>{s.title}</h2>
          {s.items.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.blurb}</p>
            </article>
          ))}
        </section>
      ))
    }

    <section class="chapter" id="resources">
      <h2>Resources</h2>
      <p>{home.resources.map((r) => r.title).join(" · ")}</p>
      <p class="words">{home.intentionWords.join(" — ")}</p>
    </section>
  </main>

  <footer class="colophon">
    <p>{home.legalName} · {home.tagline}</p>
  </footer>
</MockupShell>
