---
// Lavender linen: flat alternating full-bleed bands (cream ↔ lavender
// surface), no cards, no shadows — the content sits directly on cloth.
import MockupShell from "./MockupShell.astro";
import layoutCss from "./HomeLavLinen.css?raw";
import { home, nav } from "./_content";

interface Props {
  packCss: string;
  title: string;
  blurb?: string;
}
const { packCss, title, blurb } = Astro.props;
---

<MockupShell packCss={packCss} layoutCss={layoutCss} title={title} blurb={blurb}>
  <header class="bar">
    <span class="brand">{home.name}</span>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.anchor}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>

  <main>
    <section class="band bg" id="welcome">
      <div class="inner">
        <h1>{home.name}</h1>
        <p class="tagline">{home.tagline}</p>
        <p>{home.intention}</p>
        <a class="cta" href={home.bookingUrl}>Book a session</a>
      </div>
    </section>

    <section class="band tint" id="offerings">
      <div class="inner">
        <h2>Offerings</h2>
        {
          home.offerings.map((o) => (
            <article>
              <h3>{o.title}</h3>
              <p>{o.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="band bg" id="modalities">
      <div class="inner">
        <h2>Modalities</h2>
        {
          home.modalities.map((m) => (
            <article>
              <h3>{m.title}</h3>
              <p>{m.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="band tint" id="about">
      <div class="inner">
        <h2>About</h2>
        {
          home.about.map((a) => (
            <article>
              <h3>{a.title}</h3>
              <p>{a.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="band bg" id="resources">
      <div class="inner">
        <h2>Resources</h2>
        <p>{home.resources.map((r) => r.title).join(" · ")}</p>
        <p class="words">{home.intentionWords.join(" · ")}</p>
      </div>
    </section>
  </main>

  <footer class="band tint foot">
    <div class="inner">
      <p>{home.legalName} · {home.tagline}</p>
    </div>
  </footer>
</MockupShell>
