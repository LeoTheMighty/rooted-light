---
// Grounded skeleton (round 3, rlw110; extended round 4, rlw111): flat
// color, hairlines, solid tint bands — split into real pages (Home /
// Offerings / Modalities / About). One skeleton renders all four nav
// variants; `variant.nav` picks the treatment. Round 4 renders through
// the same skeleton with its own tan+lilac token pack per variant, puts
// Kylie Fustini in the hero, adds favorite-quote spaces, and closes
// every page with a decision sheet (exact hexes + fonts) so the round
// can settle fonts, shades, and primary-vs-secondary makeup.
// Every page is self-contained (inline CSS) and every internal link is
// an explicit ./…/index.html so the zip works over file:// at any depth.
import shared from "../_shared.css?raw";
import layoutCss from "./Grounded.css?raw";
import { home, pages, quotes } from "../_content";
import type { Direction } from "../../../pages/mockups/_directions";

const packSources = import.meta.glob("../../../styles/tokens/pack-*.css", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

interface Props {
  variant: Direction;
  page: "home" | "offerings" | "modalities" | "about";
}
const { variant, page } = Astro.props;
if (!variant.nav) throw new Error(`${variant.slug}: grounded variant missing nav kind`);

// The "/" anchor keeps a pack name that happens to be a suffix of
// another from resolving to the wrong file.
const packEntry = Object.entries(packSources).find(([path]) =>
  path.endsWith(`/${variant.pack}.css`),
);
if (!packEntry) throw new Error(`${variant.slug}: no token pack ${variant.pack}`);
const packCss = packEntry[1];

// Decision-sheet data (round 4): parsed from the pack source at build
// time — same comment-stripping rule as the review index, so a
// commented-out declaration can never drive a chip, and a missing token
// fails the build loudly.
const isR4 = variant.round === 4;
if (isR4 && variant.nav !== "classic")
  throw new Error(
    `${variant.slug}: round-4 variants use the classic nav only (the #13 skeleton; other navs don't place the spec sheet)`,
  );
if (isR4 && !variant.makeup)
  throw new Error(`${variant.slug}: round-4 variant missing makeup label`);
const strippedPack = packCss.replace(/\/\*[\s\S]*?\*\//g, "");
const token = (name: string) => {
  const v = (strippedPack.match(new RegExp(`${name}\\s*:\\s*([^;]+);`)) ||
    [])[1]?.trim();
  if (!v)
    throw new Error(`${variant.pack}: token ${name} missing or unparseable`);
  return v;
};
const fontName = (raw: string) => raw.split(",")[0]?.replace(/"/g, "").trim();
// The sheet must state what the page actually SHOWS. Tinted bands and
// the quote band render color-mix() results, not raw tokens — so those
// chips carry the same srgb mix, computed here (color-mix in srgb is a
// straight per-channel interpolation of the sRGB coordinates).
const hexRgb = (s: string) => {
  const m = s.trim().match(/^#([0-9a-f]{6})$/i);
  if (!m)
    throw new Error(`${variant.pack}: expected a 6-digit hex, got "${s}"`);
  return [0, 2, 4].map((i) => parseInt(m[1].slice(i, i + 2), 16));
};
const mix = (a: string, b: string, weightA: number) => {
  const [A, B] = [hexRgb(a), hexRgb(b)];
  return (
    "#" +
    A.map((c, i) =>
      Math.round(c * weightA + B[i] * (1 - weightA))
        .toString(16)
        .padStart(2, "0"),
    ).join("")
  );
};
const sheet = isR4
  ? {
      makeup: variant.makeup ?? "",
      chips: [
        { label: "Page", hex: token("--color-bg") },
        // matches Grounded.css --tint: color-mix(surface 55%, bg)
        {
          label: "Section tint",
          hex: mix(token("--color-surface"), token("--color-bg"), 0.55),
        },
        // matches Grounded.css .quote-band: color-mix(secondary 42%, bg)
        {
          label: "Quote band",
          hex: mix(token("--color-secondary"), token("--color-bg"), 0.42),
        },
        { label: "Accent", hex: token("--color-accent") },
        { label: "Headings", hex: token("--color-text-heading") },
      ],
      headingFont: fontName(token("--font-heading")),
      bodyFont: fontName(token("--font-body")),
    }
  : null;

const depth = page === "home" ? 0 : 1;
const base = depth ? "../" : "./";
const href = {
  home: depth ? "../index.html" : "./index.html",
  offerings: `${base}offerings/index.html`,
  modalities: `${base}modalities/index.html`,
  about: `${base}about/index.html`,
};
const backHref = depth ? "../../index.html" : "../index.html";
const pageTitle =
  page === "home" ? "Home" : pages[page as keyof typeof pages].title;
const docTitle = `${variant.title}${page === "home" ? "" : ` — ${pageTitle}`}`;
const cur = (k: string) => (k === page ? "page" : undefined);

// The pack still carries the dusk-skeleton --wash-* gradient tokens for
// the round-2 mist page; strip them here so a grounded page can never
// grow a gradient by accident.
const flatPack = packCss
  .split("\n")
  .filter((l) => !l.includes("--wash-"))
  .join("\n");
const css = `${flatPack}\n${shared}\n${layoutCss}`;
// Same guard as MockupShell: a literal "</style" in the CSS would
// terminate the inline style element — fail the build instead.
if (css.includes("</style"))
  throw new Error(`${docTitle}: injected CSS contains "</style"`);

const modalityLinks = pages.modalities.items.map((m) => ({
  label: m.title,
  href: `${href.modalities}#${m.id}`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${docTitle} · ${home.name} mockup`}</title>
    <meta name="description" content={variant.blurb} />
    <style is:inline set:html={css}></style>
  </head>
  <body class={`v-${variant.nav}`}>
    {
      variant.nav === "classic" && (
        <header class="bar">
          <a class="brand" href={href.home}>{home.name}</a>
          <nav class="site-nav" aria-label="Main">
            <a href={href.home} aria-current={cur("home")}>Home</a>
            <a href={href.offerings} aria-current={cur("offerings")}>Offerings</a>
            <details class="dd">
              <summary class={page === "modalities" ? "is-here" : undefined}>Modalities</summary>
              <div class="panel">
                {modalityLinks.map((m) => <a href={m.href}>{m.label}</a>)}
                <a class="panel-all" href={href.modalities} aria-current={cur("modalities")}>All modalities →</a>
              </div>
            </details>
            <a href={href.about} aria-current={cur("about")}>About</a>
          </nav>
        </header>
      )
    }
    {
      variant.nav === "centered" && (
        <header class="masthead">
          <a class="brand" href={href.home}>{home.name}</a>
          <nav class="site-nav" aria-label="Main">
            <a href={href.home} aria-current={cur("home")}>Home</a>
            <a href={href.offerings} aria-current={cur("offerings")}>Offerings</a>
            <details class="dd">
              <summary class={page === "modalities" ? "is-here" : undefined}>Modalities</summary>
              <div class="panel">
                {modalityLinks.map((m) => <a href={m.href}>{m.label}</a>)}
                <a class="panel-all" href={href.modalities} aria-current={cur("modalities")}>All modalities →</a>
              </div>
            </details>
            <a href={href.about} aria-current={cur("about")}>About</a>
          </nav>
        </header>
      )
    }
    {
      variant.nav === "rail" && (
        <header class="rail">
          <a class="brand" href={href.home}>{home.name}</a>
          <nav aria-label="Main">
            <a href={href.home} aria-current={cur("home")}>Home</a>
            <a href={href.offerings} aria-current={cur("offerings")}>Offerings</a>
            <a class="rail-label" href={href.modalities} aria-current={cur("modalities")}>Modalities</a>
            <div class="rail-group">
              {modalityLinks.map((m) => <a href={m.href}>{m.label}</a>)}
            </div>
            <a href={href.about} aria-current={cur("about")}>About</a>
          </nav>
        </header>
      )
    }
    {
      variant.nav === "compact" && (
        <header class="bar">
          <a class="brand" href={href.home}>{home.name}</a>
          <details class="dd menu">
            <summary>Menu</summary>
            <div class="panel">
              <a href={href.home} aria-current={cur("home")}>Home</a>
              <a href={href.offerings} aria-current={cur("offerings")}>Offerings</a>
              <p class="group-label">Modalities</p>
              {modalityLinks.map((m) => <a class="grouped" href={m.href}>{m.label}</a>)}
              <a class="grouped panel-all" href={href.modalities} aria-current={cur("modalities")}>All modalities →</a>
              <a href={href.about} aria-current={cur("about")}>About</a>
            </div>
          </details>
        </header>
      )
    }

    <main>
      {
        page === "home" && (
          <>
            <section class="hero">
              <div class="hero-inner">
                <h1>{home.name}</h1>
                {isR4 && <p class="owner-line">{home.ownerLine}</p>}
                <p class="tagline">{home.tagline}</p>
                <p class="intention">{home.intention}</p>
                <div class="offer-row">
                  {pages.offerings.items.map((o) => (
                    <a class="btn" href={`${href.offerings}#${o.id}`}>{o.title}</a>
                  ))}
                </div>
                <p class="offer-hint">
                  <a class="quiet-link" href={href.offerings}>Compare all three offerings →</a>
                </p>
              </div>
            </section>
            <section class="band">
              <div class="band-inner">
                <h2>Offerings</h2>
                <div class="cards">
                  {pages.offerings.items.map((o) => (
                    <a class="card" href={`${href.offerings}#${o.id}`}>
                      <h3>{o.title}</h3>
                      <p>{o.blurb}</p>
                      <span class="more">Learn more →</span>
                    </a>
                  ))}
                </div>
              </div>
            </section>
            {isR4 && (
              <section class="band quote-band">
                <div class="band-inner quote">
                  <figure>
                    <blockquote>
                      <p>{quotes.home.text}</p>
                    </blockquote>
                    <figcaption>— {quotes.home.attribution}</figcaption>
                  </figure>
                  <p class="quote-slot">a space for a favorite quote</p>
                </div>
              </section>
            )}
            <section class="band tint">
              <div class="band-inner">
                <h2>Modalities</h2>
                <p>{pages.modalities.intro}</p>
                <p class="mod-line">{pages.modalities.items.map((m) => m.title).join(" · ")}</p>
                <a class="quiet-link" href={href.modalities}>How I work →</a>
              </div>
            </section>
            <section class="band">
              <div class="band-inner">
                <h2>About</h2>
                <div class="cards two">
                  {pages.about.sections.map((a) => (
                    <a class="card" href={`${href.about}#${a.id}`}>
                      <h3>{a.title}</h3>
                      <p>{a.body}</p>
                      <span class="more">Read more →</span>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          </>
        )
      }
      {
        page === "offerings" && (
          <>
            <header class="page-head">
              <div class="band-inner">
                <h1>{pages.offerings.title}</h1>
                <p>{pages.offerings.intro}</p>
              </div>
            </header>
            {pages.offerings.items.map((o) => (
              <section class="entry" id={o.id}>
                <div class="band-inner">
                  <h2>{o.title}</h2>
                  <p class="meta">{o.meta}</p>
                  <p class="body">{o.body}</p>
                  <a class="btn" href="#booking-note">{o.cta}</a>
                </div>
              </section>
            ))}
          </>
        )
      }
      {
        page === "modalities" && (
          <>
            <header class="page-head">
              <div class="band-inner">
                <h1>{pages.modalities.title}</h1>
                <p>{pages.modalities.intro}</p>
              </div>
            </header>
            {pages.modalities.items.map((m) => (
              <section class="entry" id={m.id}>
                <div class="band-inner">
                  <h2>{m.title}</h2>
                  <p class="body">{m.body}</p>
                </div>
              </section>
            ))}
            {isR4 && (
              <section class="entry">
                <div class="band-inner quote inline-quote">
                  <figure>
                    <blockquote>
                      <p>{quotes.modalities.text}</p>
                    </blockquote>
                    <figcaption>— {quotes.modalities.attribution}</figcaption>
                  </figure>
                  <p class="quote-slot">a space for a favorite quote</p>
                </div>
              </section>
            )}
            <section class="entry">
              <div class="band-inner">
                <p class="body">
                  Wondering which is right for you? We'll find it together —{" "}
                  <a href={href.offerings}>start with an offering</a>.
                </p>
              </div>
            </section>
          </>
        )
      }
      {
        page === "about" && (
          <>
            <header class="page-head">
              <div class="band-inner">
                <h1>{pages.about.title}</h1>
                <p>{pages.about.intro}</p>
              </div>
            </header>
            {pages.about.sections.map((a) => (
              <section class="entry" id={a.id}>
                <div class="band-inner">
                  <h2>{a.title}</h2>
                  <p class="body">{a.body}</p>
                </div>
              </section>
            ))}
          </>
        )
      }
    </main>

    {
      sheet && (
        <aside class="spec-sheet" aria-label="Design decision sheet">
          <div class="band-inner">
            <p class="sheet-title">Decision sheet — {variant.title}</p>
            <p class="sheet-makeup">{sheet.makeup}</p>
            <div class="sheet-chips">
              {sheet.chips.map((c) => (
                <div class="chip">
                  <span class="chip-swatch" style={`background:${c.hex}`} />
                  <span class="chip-label">{c.label}</span>
                  <code class="chip-hex">{c.hex}</code>
                </div>
              ))}
            </div>
            <p class="sheet-fonts">
              Headings: <strong>{sheet.headingFont}</strong> · Body:{" "}
              <strong>{sheet.bodyFont}</strong>
            </p>
          </div>
        </aside>
      )
    }
    <footer class="ground-foot">
      <p class="foot-resources">{home.resources.map((r) => r.title).join(" · ")}</p>
      <p>{home.intentionWords.join(" · ")}</p>
      <p>{home.legalName} · {home.tagline}</p>
    </footer>

    <p class="booking-note" id="booking-note">
      Booking opens at launch — the offering buttons are placeholders for now.
    </p>
    <footer class="review-bar">
      <a href={backHref}>← All directions</a>
      <span class="which">{docTitle}</span>
    </footer>
  </body>
</html>
