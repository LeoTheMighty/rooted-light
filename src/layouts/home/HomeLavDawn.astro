---
// Lavender dawn: a short soft gradient hero (dusk's gentler cousin),
// nav row directly beneath it, then flat rounded surface cards.
import MockupShell from "./MockupShell.astro";
import layoutCss from "./HomeLavDawn.css?raw";
import { home, nav } from "./_content";

interface Props {
  packCss: string;
  title: string;
  blurb?: string;
}
const { packCss, title, blurb } = Astro.props;
---

<MockupShell packCss={packCss} layoutCss={layoutCss} title={title} blurb={blurb}>
  <section class="dawn" id="welcome">
    <h1>{home.name}</h1>
    <p class="tagline">{home.tagline}</p>
    <a class="cta" href={home.bookingUrl}>Book a session</a>
  </section>

  <nav class="ribbon" aria-label="Main">
    <ul>
      {nav.map((n) => <li><a href={n.anchor}>{n.label}</a></li>)}
    </ul>
  </nav>

  <main>
    <p class="intention">{home.intention}</p>

    <section class="pane" id="offerings">
      <h2>Offerings</h2>
      {
        home.offerings.map((o) => (
          <article>
            <h3>{o.title}</h3>
            <p>{o.blurb}</p>
          </article>
        ))
      }
    </section>

    <section class="pane" id="modalities">
      <h2>Modalities</h2>
      {
        home.modalities.map((m) => (
          <article>
            <h3>{m.title}</h3>
            <p>{m.blurb}</p>
          </article>
        ))
      }
    </section>

    <section class="pane" id="about">
      <h2>About</h2>
      {
        home.about.map((a) => (
          <article>
            <h3>{a.title}</h3>
            <p>{a.blurb}</p>
          </article>
        ))
      }
    </section>

    <section class="pane" id="resources">
      <h2>Resources</h2>
      <p>{home.resources.map((r) => r.title).join(" · ")}</p>
      <p class="words">{home.intentionWords.join(" · ")}</p>
    </section>
  </main>

  <footer class="foot">
    <p>{home.legalName} · {home.tagline}</p>
  </footer>
</MockupShell>
