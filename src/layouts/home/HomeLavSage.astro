---
// Lavender sage: centered thin masthead with a leaf mark, sage
// small-caps kickers over lavender headings, two-column grids at
// desktop. Simple, botanical, fresh.
import MockupShell from "./MockupShell.astro";
import layoutCss from "./HomeLavSage.css?raw";
import { home, nav } from "./_content";

interface Props {
  packCss: string;
  title: string;
  blurb?: string;
}
const { packCss, title, blurb } = Astro.props;
---

<MockupShell packCss={packCss} layoutCss={layoutCss} title={title} blurb={blurb}>
  <header class="mast">
    <p class="brand">{home.name}</p>
    <svg class="leaf" viewBox="0 0 80 24" aria-hidden="true">
      <path
        d="M4 12 C 24 2, 56 2, 76 12 C 56 22, 24 22, 4 12 Z M 40 4 L 40 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"></path>
    </svg>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.anchor}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero" id="welcome">
      <p class="kicker">therapy · reiki · rest</p>
      <h1>{home.tagline}</h1>
      <p class="intention">{home.intention}</p>
      <a class="cta" href={home.bookingUrl}>Book a session</a>
    </section>

    <section class="patch" id="offerings">
      <p class="kicker">Offerings</p>
      <div class="duo">
        {
          home.offerings.map((o) => (
            <article>
              <h3>{o.title}</h3>
              <p>{o.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="patch" id="modalities">
      <p class="kicker">Modalities</p>
      <div class="duo">
        {
          home.modalities.map((m) => (
            <article>
              <h3>{m.title}</h3>
              <p>{m.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="patch" id="about">
      <p class="kicker">About</p>
      <div class="duo">
        {
          home.about.map((a) => (
            <article>
              <h3>{a.title}</h3>
              <p>{a.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="patch" id="resources">
      <p class="kicker">Resources</p>
      <p>{home.resources.map((r) => r.title).join(" · ")}</p>
    </section>
  </main>

  <footer class="foot">
    <p>{home.legalName} · {home.tagline}</p>
  </footer>
</MockupShell>
