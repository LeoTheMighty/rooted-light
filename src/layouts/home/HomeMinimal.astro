---
// Quiet minimal light: tiny small-caps nav, one narrow text column,
// hairline dividers, no cards or surfaces at all. Brightness-first;
// the type carries everything.
import MockupShell from "./MockupShell.astro";
import layoutCss from "./HomeMinimal.css?raw";
import { home, nav } from "./_content";

interface Props {
  packCss: string;
  title: string;
  blurb?: string;
}
const { packCss, title, blurb } = Astro.props;
---

<MockupShell packCss={packCss} layoutCss={layoutCss} title={title} blurb={blurb}>
  <header class="whisper">
    <span class="brand">{home.name}</span>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.anchor}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero" id="welcome">
      <h1>{home.tagline}</h1>
      <p class="intention">{home.intention}</p>
    </section>

    <section class="quiet" id="offerings">
      <h2>Offerings</h2>
      {
        home.offerings.map((o) => (
          <article>
            <h3>{o.title}</h3>
            <p>{o.blurb}</p>
          </article>
        ))
      }
      <p class="cta-line">
        <a href={home.bookingUrl}>Book a session →</a>
      </p>
    </section>

    <section class="quiet" id="about">
      <h2>About</h2>
      {
        home.about.map((a) => (
          <article>
            <h3>{a.title}</h3>
            <p>{a.blurb}</p>
          </article>
        ))
      }
    </section>

    <section class="quiet" id="resources">
      <h2>Resources</h2>
      <p>{home.resources.map((r) => r.title).join(" · ")}</p>
      <p class="words">{home.intentionWords.join("  ·  ")}</p>
    </section>
  </main>

  <footer class="whisper-foot">
    <p>{home.legalName} · {home.tagline}</p>
  </footer>
</MockupShell>
