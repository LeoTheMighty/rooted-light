---
// Shared page layout: landmarks (<header>/<main>/<footer>), global nav from
// site.json, one-<h1>-per-page rule (the layout owns the h1; pages pass
// `title` and start their own headings at h2).
import site from "../content/site.json";
import "../styles/base.css";
// The promoted theme (rlw105): Leo's pick — round-4 "Warm sand & lilac"
// (rlw111). Imported after base.css so the pack's :root tokens override
// the neutral defaults on every real-site route. Mockup routes keep
// their own self-contained packs (_shared.css), untouched.
import "../styles/tokens/pack-sand-lilac.css";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  /** Skip the layout-rendered <h1> (a page that renders its own hero h1). */
  bareTitle?: boolean;
  /** Per-page meta description; falls back to the site intention line. */
  description?: string;
  /** "hero" (rlw115, home only): nav floats transparent over the page's
   *  own full-viewport wash hero; main is full-bleed (the page manages
   *  its own wrapping); footer wears the wash-foot treatment. Every
   *  other page keeps the default rendering untouched. */
  variant?: "default" | "hero";
}

const {
  title,
  bareTitle = false,
  description = site.intention,
  variant = "default",
} = Astro.props;
const isHero = variant === "hero";
const docTitle = title === site.name ? site.name : `${title} · ${site.name}`;
// Astro.url.pathname includes the configured base, so hrefs are
// base-prefixed via withBase() before comparing.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  (withBase(href).replace(/\/$/, "") || "/") === currentPath;
// Temporary-preview deploys (rlw112) must not get indexed; the flag is
// only set by the Pages workflow, never by the default build.
const noindex = Boolean(process.env.DEPLOY_NOINDEX);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class={isHero ? "page-hero" : undefined}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase("/")}>{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={withBase(item.href)}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main class={isHero ? "full-bleed" : "wrap flow"}>
      {!bareTitle && !isHero && <h1>{title}</h1>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{site.legal_name} · {site.tagline}</p>
      </div>
    </footer>
  </body>
</html>
