---
// One explainer card in the Resources section: title linking to the
// full explainer page (kept as a standalone route), summary, and any
// outbound reference links (ICRT etc.). h3 fits the one-pager outline
// (h2 Resources → h3 card).
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/paths";

interface Props {
  resource: CollectionEntry<"resources">;
}
const { resource } = Astro.props;
---

<article class="card">
  <h3><a href={withBase(`/resources/${resource.id}/`)}>{resource.data.title}</a></h3>
  <p>{resource.data.summary}</p>
  {
    resource.data.links.length > 0 && (
      <ul>
        {resource.data.links.map((l) => (
          <li>
            <a href={withBase(l.url)}>{l.label}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>
